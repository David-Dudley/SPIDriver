#Reset the chip
record(ao, "${P}${S}AIM_NADS114:REBT_CMD") {
  field(DTYP, "SPIdig")
  field(DESC, "Reset the ADS114 Chip")
  field(OUT, "@${DEV} -C 1  WRITE8  0x06 ")
}

