#Read the temperature of the chip
record(ai, "${P}${S}AIM_NADS114:T_RD") {
  field(DTYP, "SPIdig")
  field(DESC, "Read the Chip Temperature Reg")
#                                               Chan  PGA   SNGL  Intl  No    Disc       Temp
#                                               ACOM   1   20SPS        Excit EXC    NO   4 Smpl
#                                               MUX   PGA   Rate  Ref   EXCIT EXC2  BIAS  SYS
#                                     Reg 2  #   2      3     4     5     6     7     8     9
  field(INP, "@${DEV} -C 1 ADS114READ  0x42, 7, 0x01, 0x00, 0x3e, 0x3a, 0x00, 0xff, 0x00, 0x58")
  field(SCAN, "Passive")
  field(LINR, "LINEAR")
  field(ASLO, "0.000076292")
  field(EOFF, "24.9")
  field(ESLO, "4.03")
  field(PREC, "2")
  field(EGUF, "100")
  field(EGUL, "0")
  field(EGU, "DegC")
  field(AOFF, "0")
}

