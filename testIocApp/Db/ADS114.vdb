  field(DTYP, "SPIdig")
  field(DESC, "Read the ID Reg")
#                                    Reg 0  #  0
  field(INP, "@${DEV} -C 1 -i 2 READ8  0x20, 0, 0")
  field(SCAN, "10 second")
  field(PINI, "YES")
}

