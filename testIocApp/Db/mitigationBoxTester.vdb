record(mbboDirect, "${P}${S}CONTROL:LTCH_CSET") {
  field(DTYP, "SPIdig")
  field(DESC, "Write the Output Control Latch register")
  field(OUT, "@${DEV} -C 2 -i 0 WRITE8  0")
  field(FLNK, "${P}${S}CONTROL:LTCH_RSET")
}

