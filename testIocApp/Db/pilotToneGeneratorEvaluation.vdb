#Write the Device Status
record(mbboDirect, "${P}${S}PILOT_TEST:CONTROLS_CSET") {
  field(DTYP, "SPIdig")
  field(DESC, "Write the Board Control register")
  field(OUT, "@${DEV} -C 2 -i 0 WRITE8  0")
}

#Set the DAC Output
record(ao, "${P}${S}PILOT_TEST:DAC_A_CSET") {
  field(DTYP, "SPIdig")
  field(DESC, "Set the DAC Value")
  field(OUT, "@${DEV} -C 1  WRITE8  0x00")
}

