#Configuration records for the chip
#Seems I can't preset the values for the MBBO records,
# so I'll write them into a SEQ record
record(seq, "${P}${S}AMC7823Config") {
  field(DESC, "Configuration sequence for the AMC7823")
  field(SCAN, "Passive")
  field(DOL0, "0x8fa0")
  field(LNK0, "${P}${S}AMC7823PutPowerDown.VAL PP")
  field(DLY0, "0.1")
  field(DOL1, "0x0040")
  field(LNK1, "${P}${S}AMC7823PutStat/Config.VAL PP")
  field(DLY1, "0.1")
  field(DOL2, "0x8080")
  field(LNK2, "${P}${S}AMC7823PutCtrl PP")
  field(DLY2, "0.1")
  field(DOL3, "0xffff")
  field(LNK3, "${P}${S}AMC7823PutGPIO PP")
  field(DLY3, "0.1")
  field(DOL4, "0x00ff")
  field(LNK4, "${P}${S}AMC7823PutDACConfig PP")
  field(DLY4, "0.1")
  field(PINI, "YES")
}

# Write to the Power-Down register
record(mbboDirect, "${P}${S}AMC7823PutPowerDown") {
  field(DTYP, "SPIdig")
  field(DESC, "Write to the Power-Down register")
  field(OUT, "@mySPI -C 0 -I 1  WRITE16  0x134d, 0")
}

#Write to the Status Reglster
record(mbboDirect, "${P}${S}AMC7823PutStat/Config") {
  field(DTYP, "SPIdig")
  field(DESC, "Write to the Status/Config register")
  field(OUT, "@mySPI -C 0 -I 1  WRITE16  0x128a, 0")
}

#Write to the Control Register
record(mbboDirect, "${P}${S}AMC7823PutCtrl") {
  field(DTYP, "SPIdig")
  field(OUT, "@mySPI -C 0 -I 1  WRITE16  0x12cb, 0")
  field(DESC, "Write to the Control Register")
}

record(ai, "${P}${S}AMC7823GetPowerDown") {
  field(DTYP, "SPIdig")
  field(INP, "@mySPI -C 0 -i 1 READ16  0x934d, 0")
}

record(ai, "${P}${S}AMC7823GetStat/Config") {
  field(DTYP, "SPIdig")
  field(INP, "@mySPI -C 0 -i 1 READ16  0x928a, 0")
}

record(ai, "${P}${S}AMC7823GetCtrl") {
  field(DTYP, "SPIdig")
  field(INP, "@mySPI -C 0 -i 1 READ16  0x92cb, 0")
}

record(mbboDirect, "${P}${S}AMC7823PutGPIO") {
  field(DESC, "Write the GPIO register")
  field(DTYP, "SPIdig")
  field(OUT, "@mySPI -C 0 -I 1 WRITE16 0x0280, 0")
}

record(mbbiDirect, "${P}${S}AMC7823GetGPIO") {
  field(DESC, "Read the GPIO Register")
  field(DTYP, "SPIdig")
  field(INP, "@mySPI -C 0 -i 1 READ16 0x8280, 0")
}

record(mbboDirect, "${P}${S}AMC7823PutDACConfig") {
